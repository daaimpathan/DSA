class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        long long current_sum = 0;

        for (int i = 0; i < k; i++)
            current_sum += nums[i];

        long long maxsum = current_sum;

        for (int r = k, l = 0; r < nums.size(); r++, l++) {
            current_sum += nums[r];
            current_sum -= nums[l];
            maxsum = max(maxsum, current_sum);
        }
        return (double)maxsum / k;
    }
};
